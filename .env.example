# Server-only Supabase configuration. Never expose the secret key to app.js.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_replace_with_hosting_secret

# Generate a long random value and keep it only in the hosting secret store.
SESSION_SECRET_KEY=replace_with_a_long_random_session_secret

# Optional integration.
TELEGRAM_BOT_TOKEN=
